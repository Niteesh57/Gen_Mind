# Backblaze B2 is already the storage abstraction used by the pipeline. Populate the
# deployment's B2 credentials there; without credentials the existing local B2-shaped
# development sink is used.
B2_BUCKET_NAME=genblaze-studio-bucket
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=

# Microsoft Azure Speech (F0/free tier is supported)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Used by the SDK-native GenBlaze image pipeline
GEMINI_API_KEY=
REPLICATE_API_KEY=
GENBLAZE_IMAGE_MODEL=stability-ai/sdxl

# Optional GenBlaze-compatible endpoints. Each receives:
# { "task": "image" | "render_video", "input": { ... } }
# and returns { "url": "https://..." } or, for images, { "data": "base64..." }.
GENBLAZE_API_KEY=
GENBLAZE_IMAGE_API_URL=
GENBLAZE_VIDEO_API_URL=

# Built-in GMI Cloud video adapter (the model ID is selected in the UI).
GMI_CLOUD_VIDEO_API_URL=
GMI_CLOUD_API_KEY=

# Optional third-party provider registry. The key becomes the UI/API provider id.
# GENMIND_MEDIA_PROVIDERS={"my-provider":{"endpoint":"https://provider.example/v1/video","api_key_env":"MY_PROVIDER_API_KEY"}}
